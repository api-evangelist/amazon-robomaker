{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-robomaker/refs/heads/main/json-schema/amazon-robomaker-openapi-failure-summary-schema.json",
  "title": "FailureSummary",
  "description": "Information about worlds that failed.",
  "type": "object",
  "properties": {
    "totalFailureCount": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Integer"
        },
        {
          "description": "The total number of failures."
        }
      ]
    },
    "failures": {
      "allOf": [
        {
          "$ref": "#/components/schemas/WorldFailures"
        },
        {
          "description": "The worlds that failed."
        }
      ]
    }
  }
}